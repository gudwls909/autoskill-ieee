--- voyager_vb/voyager/agents/skill.py	2026-08-20 06:44:34.034685340 +0900
+++ voyager_ed/voyager/agents/skill.py	2026-11-14 14:00:31.393507593 +0900
@@ -76,6 +76,21 @@
         print(
             f"\033[33mSkill Manager generated description for {program_name}:\n{skill_description}\033[0m"
         )
+        # R3.1 baseline: embedding-similarity dedup. Skip storing when the new description's cosine
+        # similarity to an existing skill (other than an overwrite of the same name) is >= EMB_DEDUP_TAU.
+        tau = float(os.environ.get("EMB_DEDUP_TAU", "0.95"))
+        if self.skills and program_name not in self.skills:
+            q = self.vectordb._embedding_function.embed_query(skill_description)
+            hit = self.vectordb._collection.query(query_embeddings=[q], n_results=1, include=["embeddings"])
+            e = hit["embeddings"][0][0]
+            cos = sum(a * b for a, b in zip(q, e)) / ((sum(a * a for a in q) ** 0.5) * (sum(b * b for b in e) ** 0.5))
+            if cos >= tau:
+                print(f"\033[33mSkill Manager: embedding dedup — {program_name} ~ {hit['ids'][0][0]} (cos={cos:.3f}). Skipping.\033[0m")
+                self.last_dedup = {"status": "dedup", "representative": hit["ids"][0][0], "cos": cos}
+                return
+            self.last_dedup = {"status": "added", "representative": hit["ids"][0][0], "cos": cos}
+        else:
+            self.last_dedup = {"status": "added", "representative": None}
         if program_name in self.skills:
             print(f"\033[33mSkill {program_name} already exists. Rewriting!\033[0m")
             self.vectordb._collection.delete(ids=[program_name])
